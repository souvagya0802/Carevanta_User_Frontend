# Base URL of the Carevanta API (no trailing slash). The browser calls it directly,
# so the API's CORS_ORIGINS must include this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3002

# Map tiles (optional). Empty = free OpenStreetMap tiles, fine for the pilot.
# For heavier use, point this at a keyed tile server, e.g. MapTiler (free tier):
#   NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# Tile keys are public by design (the browser sends them); restrict them to your domain in the provider console.
# Place search and address lookup never use this: they go through the API (GEOCODER_* in the API .env).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
